# Copy to .env.local and fill in. .env.local is gitignored.
# Tip: `pnpm get-token` fills both values in for you via the OTP login flow.

# API base URL as seen by the browser. Keep this relative: in dev the browser
# calls /api on the Vite dev server (same-origin, no CORS) and Vite proxies it to
# the real backend. To target a different backend, set API_PROXY_TARGET when
# running the dev server, e.g. `API_PROXY_TARGET=http://localhost:8080 pnpm dev`
# (default is https://libs.roboai.fi).
VITE_API_BASE=/api

# Bearer token for the API. Obtain one via the passwordless OTP login flow
# (run `pnpm get-token`, or see README -> "Connecting to the API"). Leave blank to
# load the UI without a backend, but compute requests fail until a token is set.
VITE_API_TOKEN=your-bearer-token-here
